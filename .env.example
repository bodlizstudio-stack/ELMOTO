# Lokalna baza. Za produkcijo zamenjajte s PostgreSQL, npr.
# postgresql://uporabnik:geslo@localhost:5432/elmoto?schema=public
DATABASE_URL="file:./dev.db"

# Dolga naključna vrednost. Objavite jo samo kot strežniško skrivnost.
AUTH_SECRET="zamenjajte-z-dolgim-nakljucnim-nizom"

# Začetni administrator. Geslo se ob seedu shrani samo kot bcrypt zgoščena vrednost.
ADMIN_EMAIL="admin@elmoto.si"
ADMIN_PASSWORD="zamenjajte-me"
ADMIN_NAME="EL-MOTO"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Prejemnik obvestil o povpraševanjih.
NOTIFY_EMAIL="info@elmoto.si"

# Resend (prednost, če je ključ nastavljen)
RESEND_API_KEY=""
MAIL_FROM="EL-MOTO <info@elmoto.si>"

# Ali SMTP, če Resend ni nastavljen
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
